# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=logistics
DATABASE_USER=logistics_app
DATABASE_PASSWORD=changeme
DB_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:logistics-db-password

# AWS
AWS_REGION=eu-west-1
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxx

# S3
S3_BUCKET_NAME=logistics-assets

# Customer-facing frontend origin — used to build the account-creation invite
# link (`{CUSTOMER_PORTAL_BASE_URL}/invite/{token}`) sent by SMS/WhatsApp/email.
# Falls back to a relative "/invite/{token}" link when unset (fine for local
# dev where the SMS/WhatsApp send is only ever inspected via the SQS queue).
CUSTOMER_PORTAL_BASE_URL=https://app.shipx.example.com

# EventBridge
EVENT_BUS_NAME=logistics-events

# Service
SERVICE_NAME=logistics-unknown
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# Tracing
AWS_XRAY_TRACING_NAME=logistics
_X_AMZN_TRACE_ID=Root=1-00000000-000000000000000000000000

# Paystack — no longer a global env var (2026-07-19, multi-tenant). Each
# tenant connects their own secret key via PUT /v1/tenant/config/paystack —
# see LOCAL_TESTING.md's "Online payments" section.

# Comma-separated phones/emails that may receive notifications outside
# production. Empty (the default) means no notification is ever sent from a
# non-production environment — dev databases hold real customer contacts.
NOTIFICATION_ALLOWLIST=

# Meta WhatsApp Cloud API. META_WHATSAPP_PHONE_ID is the numeric Phone number
# ID from the Meta dashboard, not the display number. Templates are approved
# per language and the request must match — Meta's samples are en_US.
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TEMPLATE_LANG=en_US

# WhatsApp Business Account ID (template management; see docs whatsapp_templates.md)
META_WABA_ID=
