# Keep the build context small and the image clean. The Dockerfile copies only
# shared/, services/, scripts/, migrations/ and the entrypoint — everything else
# is excluded here so a stray local artifact can't bloat or poison the image.
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
build/
dist/
*.egg-info
tests/
frontend/
infrastructure/
docs/
*.md
.env*
docker-compose*.yml
coverage.xml
.coverage
