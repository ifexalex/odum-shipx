# Local-stack environment — copy to .env.local (the Makefile does this for you).
#
# Non-secret: every value here targets the docker-compose.local.yml stack
# (Postgres + Moto + Redis) with Moto's dummy credentials. `.env.local` itself
# is gitignored (it once held live Cognito IDs — commit 6c0f955); this sample is
# the tracked template both `make` and CI copy from. scripts/bootstrap_local.sh
# rewrites COGNITO_* / SQS_* in the generated .env.local on every run.

# ─── Database (matches docker-compose.local.yml) ─────────────────────────────
# TWO credentials, and they are not interchangeable (migration 060).
#
#   DATABASE_USER/PASSWORD    the APPLICATION role. `logistics_app` holds only
#                             DML and has no BYPASSRLS, so the row-level
#                             security policies are actually enforced.
#   DATABASE_ADMIN_*          the OWNER. reset_db.py, alembic and seed.py need
#                             it for DDL and cross-tenant fixture writes.
#   APP_DB_PASSWORD           what migration 060 sets on logistics_app.
#                             MUST equal DATABASE_PASSWORD below, or the stack
#                             builds and then every request fails with
#                             "password authentication failed".
#
# The two are pre-filled with the SAME literal so a verbatim copy of this file
# just works — `make env` and .github/workflows/frontend-ci.yml both copy it
# unedited, and placeholders that differed by a word broke both: migration 060
# set one password and the app connected with the other. It is a local-only,
# non-secret value, exactly like DATABASE_ADMIN_PASSWORD below.
#
# To use your own, generate it with
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# and paste the SAME value into both DATABASE_PASSWORD and APP_DB_PASSWORD.
#
# Leaving DATABASE_USER=postgres and omitting the admin pair also works —
# shared/db_credentials.py falls back — but RLS is then inert locally, so
# tenant-isolation bugs will not show up until production.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=logistics
DATABASE_USER=logistics_app
DATABASE_PASSWORD=local_app_password_not_a_secret
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=localpassword
APP_DB_PASSWORD=local_app_password_not_a_secret
DB_SECRET_ARN=

# ─── AWS (point boto3 at Moto server) ────────────────────────────────────────
AWS_DEFAULT_REGION=eu-west-1
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:5100

# ─── EventBridge ──────────────────────────────────────────────────────────────
EVENT_BUS_NAME=logistics-events

# ─── SQS queues (created by scripts/bootstrap_local.sh) ─────────────────────
SQS_SMS_QUEUE_URL=http://localhost:5100/123456789012/logistics-sms
SQS_WHATSAPP_QUEUE_URL=http://localhost:5100/123456789012/logistics-whatsapp
SQS_EMAIL_QUEUE_URL=http://localhost:5100/123456789012/logistics-email
SQS_METERING_QUEUE_URL=http://localhost:5100/123456789012/logistics-metering

# ─── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=logistics-assets

# ─── Cognito (rewritten by scripts/bootstrap_local.sh each run) ──────────────
COGNITO_USER_POOL_ID=eu-west-1_localpool
COGNITO_CLIENT_ID=localclient

# ─── Real Microsoft Entra integration, run LOCALLY (optional) ────────────────
# Off by default: local dev uses Moto Cognito + the dev auth shim. Uncomment to
# point the LOCAL backend at the REAL Entra External ID (CIAM) tenant, so Entra
# work (Graph provisioning, claims, login) can be tested from localhost without
# deploying. There is no 1:1 Entra emulator — the community ones expose only a
# minimal read-only Graph, so they cannot exercise our Graph *writes* (create
# user/group, $ref member add, passwordProfile). See LOCAL_TESTING.md §15.
#
# WARNING: these are REAL directory writes against the shared CIAM tenant. Use a
# dedicated test email per run and clean up afterwards. Never commit the secret —
# .env.local is gitignored; this sample is tracked.
#
# CLOUD_PROVIDER=azure
# AUTH_PROVIDER=azure
# ENTRA_GRAPH_TENANT_ID=062cb98d-8990-4947-81c4-223cb1e9b8f3
# ENTRA_GRAPH_CLIENT_ID=37c40cbe-5995-4b37-9d2a-0d6a02624426
# ENTRA_GRAPH_CLIENT_SECRET=            # from the shipx-graph-provisioner app — DO NOT COMMIT
# ENTRA_USER_DOMAIN=shipxcustomer.onmicrosoft.com
# ENTRA_LOCAL_ACCOUNTS=true
# ENTRA_CLIENT_ID=c6d0fc93-1fb5-43c5-9621-513abf93c5d6
# ENTRA_TOKEN_ENDPOINT=https://shipxcustomer.ciamlogin.com/shipxcustomer.onmicrosoft.com/oauth2/v2.0/token
# ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
# ENTRA_PLATFORM_ADMIN_GROUP_ID=7eec8dba-c70f-4043-b84d-5c3a82b86c37
# OIDC_AUDIENCE=c6d0fc93-1fb5-43c5-9621-513abf93c5d6
# OIDC_JWKS_URL=https://shipxcustomer.ciamlogin.com/062cb98d-8990-4947-81c4-223cb1e9b8f3/discovery/v2.0/keys

# ─── Notification links ───────────────────────────────────────────────────────
# Absolute base URL for links in outbound notifications — account activation
# (/activate/{token}) and customer invites (/invite/{token}). shared/app_urls.py
# refuses to build a relative link, so with this unset those notifications are
# not sent at all and say so in the log. It used to emit "/invite/<token>",
# which no mail client can open.
APP_BASE_URL=http://localhost:5173
# Only if the customer portal is ever hosted separately from the staff app.
# CUSTOMER_PORTAL_BASE_URL=http://localhost:5173

# Sender for outbound email. Moto enforces SES's verified-identity rule, so this
# must match the address `make bootstrap` verifies. The application default is
# notifications@logistics.example.com, which is rejected — in production too,
# which is why the Terraform notification guard refuses an empty value there.
SES_FROM_ADDRESS=notifications@shipx.local

# Outside production NOTHING is messaged unless the contact is listed here —
# the dev and staging databases hold real imported customer contacts, and a
# manifest import creates customers straight from the forwarder's file, phone
# numbers and all. Comma-separated phones/emails.
# NOTIFICATION_ALLOWLIST=+2348000000000,you@example.com

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=DEBUG
SERVICE_NAME=logistics-local

# ─── X-Ray (disable locally) ──────────────────────────────────────────────────
AWS_XRAY_SDK_ENABLED=false
_X_AMZN_TRACE_ID=Root=1-00000000-000000000000000000000000

# ─── Redis (distributed tenant-status cache) ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
