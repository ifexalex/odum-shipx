# No secret values belong here — see 01_project_setup.md.
# Injected at build time per environment by CI/CD (13_deployment_and_cicd.md).
VITE_API_BASE_URL=https://api.shipx.co
VITE_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Platform admins' pool, MFA required (platform audit Phase 1b): terraform output cognito_platform_*.
# Unset, the login screen offers no platform admin sign-in.
VITE_COGNITO_PLATFORM_USER_POOL_ID=
VITE_COGNITO_PLATFORM_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-1
VITE_ENVIRONMENT=local
