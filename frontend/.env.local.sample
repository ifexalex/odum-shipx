# Copy to .env.local (gitignored) for local dev against `make stack` / `make up`:
#
#     cp frontend/.env.local.sample frontend/.env.local
#
# Tracked deliberately, and named .sample rather than .example because the root
# .gitignore ignores `.env.*` and only negates `!.env.example` and
# `!.env.local.sample` — the latter has no slash, so it un-ignores this file at
# any depth. It mirrors the backend's own .env.local.sample.
#
# This file must exist BEFORE `make bootstrap` runs: scripts/bootstrap_local.sh
# rewrites the two VITE_COGNITO_*_ID lines below with the pool/client IDs Moto
# generates, and only if the file is already there. .github/workflows/
# frontend-ci.yml's e2e-local-stack job copies this for the same reason — without
# it VITE_API_BASE_URL is undefined and src/api/client.ts throws before any
# request is sent, so every API call fails.
#
# No secrets belong here. scripts/local_server.py accepts X-Tenant-ID / X-Role /
# X-User-ID headers directly, so no real Cognito is needed locally (see
# 04_auth_and_session.md's dev-mode shim).

VITE_API_BASE_URL=http://localhost:3000

# Placeholders — `make bootstrap` / `make stack` overwrite both with the real
# Moto-generated values. They are regenerated on every bootstrap, so a stale
# pair here is expected and harmless.
VITE_COGNITO_USER_POOL_ID=local
VITE_COGNITO_CLIENT_ID=local
VITE_COGNITO_REGION=eu-west-1
VITE_ENVIRONMENT=local

# Points the real Cognito path at Moto via Vite's same-origin /__cognito proxy
# (see frontend/vite.config.ts) instead of AWS, so the actual /login screen
# works locally without Moto CORS preflight failures. auth-logout.spec.ts
# performs a real login/logout round trip and needs this.
VITE_COGNITO_ENDPOINT=http://localhost:5173/__cognito
